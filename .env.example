# Root domain configuration
ROOT_DOMAIN=aroadmap.dev
NEXT_PUBLIC_ROOT_DOMAIN=aroadmap.dev

# Configure these per tenant using its uppercase ID in place of ACME.
AROADMAP_MCP_URL_ACME=https://agentic-fleet.example.com/api/mcp
AROADMAP_TRIGGER_TOKEN_ACME=replace-with-tenant-trigger-token
AROADMAP_TOKEN_ACME=replace-with-tenant-status-token
AROADMAP_OPERATOR_PASSWORD_ACME=replace-with-at-least-32-random-bytes
AROADMAP_OPERATOR_SESSION_SECRET_ACME=replace-with-a-different-32-byte-random-value
